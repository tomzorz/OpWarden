<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- UI Automation for the session-agent tests, and the agent's WPF types. -->
    <UseWPF>true</UseWPF>
    <!-- Test names are sentences; underscores keep them readable in the runner. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (global.json), so no VSTest adapter. -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- WPF drops System.IO from the implicit usings over Path; the tests never use shapes. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpWarden.Core\OpWarden.Core.csproj" />
    <ProjectReference Include="..\OpWarden.Broker\OpWarden.Broker.csproj" />
    <!-- Built for their output only: the end-to-end tests run them as real processes. -->
    <ProjectReference Include="..\OpWarden.Shim\OpWarden.Shim.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\OpWarden.Probe\OpWarden.Probe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\OpWarden.SessionAgent\OpWarden.SessionAgent.csproj" />
  </ItemGroup>

</Project>
