<Window x:Class="OpWarden.SessionAgent.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpWarden.SessionAgent"
        Title="OpWarden"
        AutomationProperties.AutomationId="PromptWindow"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Grid Margin="{StaticResource PromptShadowMargin}">
        <local:WindowFrame>
            <local:SpacedStackPanel Spacing="{StaticResource WindowSectionSpacing}">

                <!-- Header: drag to move; the cross is disallow-once. -->
                <local:SpacedStackPanel x:Name="Header" Orientation="Horizontal" Spacing="{StaticResource HeaderItemSpacing}" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                    <local:OpWardenMark VerticalAlignment="Center" />
                    <local:SpacedStackPanel local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" Spacing="{StaticResource HeaderSubtitleSpacing}">
                        <local:PromptTitleText x:Name="TitleText" />
                        <local:SecretValueText x:Name="CommandText" />
                    </local:SpacedStackPanel>
                    <local:PromptCountdownText x:Name="CountdownText" VerticalAlignment="Center" AutomationProperties.AutomationId="Countdown" />
                    <local:WindowCloseButton VerticalAlignment="Center" Click="OnCloseClick" />
                </local:SpacedStackPanel>

                <!-- The request tuple, one row per field with its pin when always- decisions are offered, and what the pins mean. -->
                <local:SpacedStackPanel Spacing="{StaticResource SupportingTextSpacing}">
                    <local:DetailsPanel>
                        <ItemsControl x:Name="FieldList" Focusable="False" ItemsPanel="{StaticResource FieldRowsLayout}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource FieldColumnSpacing}">
                                        <local:FieldPinCheckBox Width="{StaticResource PromptFieldLabelWidth}" VerticalAlignment="Center"
                                                                Content="{Binding Label}" IsChecked="{Binding IsPinned}" IsEnabled="{Binding Pinnable}"
                                                                Visibility="{Binding PinVisibility}" AutomationProperties.AutomationId="{Binding PinAutomationId}"
                                                                ToolTip="Pinned in an always- rule; unpinned matches anything" />
                                        <local:FieldLabelText Width="{StaticResource PromptFieldLabelWidth}" VerticalAlignment="Center" Text="{Binding Label}" Visibility="{Binding LabelVisibility}" />
                                        <local:SecretValueText local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" Text="{Binding Value}" ToolTip="{Binding Value}" />
                                    </local:SpacedStackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </local:DetailsPanel>
                    <local:HintText x:Name="PinHintText" Text="Checked fields are pinned in an always- rule; unchecked fields match anything." />
                </local:SpacedStackPanel>

                <!-- A run lists every reference it uses. -->
                <local:SpacedStackPanel x:Name="ReferencesPanel" Spacing="{StaticResource SectionHeadingSpacing}">
                    <local:SectionHeadingText Text="Secret references" />
                    <local:SpacedStackPanel Spacing="{StaticResource SupportingTextSpacing}">
                        <ItemsControl x:Name="ReferenceList" Focusable="False" ItemsPanel="{StaticResource ListItemsLayout}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:SecretValueText Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <local:HintText x:Name="ReferencesNoteText" />
                    </local:SpacedStackPanel>
                </local:SpacedStackPanel>

                <!-- REQ-RULE-19: how long an allowed read's output may be served from the cache. -->
                <local:SpacedStackPanel x:Name="CachePanel" Spacing="{StaticResource SectionHeadingSpacing}">
                    <local:SectionHeadingText Text="Cache the output" />
                    <local:SpacedStackPanel x:Name="CacheChoices" Orientation="Horizontal" Spacing="{StaticResource CacheChoiceSpacing}" />
                </local:SpacedStackPanel>

                <!-- Allow on the left, refuse on the right; none of them is the default. -->
                <Grid>
                    <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource CommandSpacing}" HorizontalAlignment="Left">
                        <local:AllowDecisionButton x:Name="AllowOnceButton" Content="Allow once" AutomationProperties.AutomationId="AllowOnceButton" Click="OnAllowOnceClick" />
                        <local:AllowDecisionButton x:Name="AlwaysAllowButton" Content="Always allow" AutomationProperties.AutomationId="AlwaysAllowButton" Click="OnAlwaysAllowClick" />
                    </local:SpacedStackPanel>
                    <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource CommandSpacing}" HorizontalAlignment="Right">
                        <local:DenyDecisionButton x:Name="DisallowOnceButton" Content="Disallow once" AutomationProperties.AutomationId="DisallowOnceButton" Click="OnDisallowOnceClick" />
                        <local:DenyDecisionButton x:Name="AlwaysDisallowButton" Content="Always disallow" AutomationProperties.AutomationId="AlwaysDisallowButton" Click="OnAlwaysDisallowClick" />
                    </local:SpacedStackPanel>
                </Grid>
            </local:SpacedStackPanel>
        </local:WindowFrame>
    </Grid>
</Window>
