<local:StandardWindow x:Class="OpWarden.SessionAgent.AuditWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:OpWarden.SessionAgent"
                      Title="OpWarden audit log"
                      AutomationProperties.AutomationId="AuditWindow"
                      Width="1180" Height="680" MinWidth="760" MinHeight="420"
                      WindowStartupLocation="CenterScreen">
    <local:SpacedStackPanel Margin="{StaticResource StandardWindowContentMargin}" Spacing="{StaticResource WindowSectionSpacing}">

        <!-- Filters and what is shown. -->
        <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource ToolbarGroupSpacing}">
            <local:RecordFilterBox x:Name="FilterBox" Width="340" AutomationProperties.AutomationId="AuditFilter" Placeholder="Filter: caller, secret, event, verdict…" />
            <local:RecordFilterToggle x:Name="ProblemsOnly" VerticalAlignment="Center" Content="Problems only" />
            <local:HintText x:Name="SummaryText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" TextAlignment="Right" />
            <local:CommandButton Content="Open folder" Click="OnOpenFolderClick" />
        </local:SpacedStackPanel>

        <local:RecordGrid x:Name="Records" local:SpacedStackPanel.Fill="True" AutomationProperties.AutomationId="AuditRecords">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150" />
                <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="130" />
                <DataGridTextColumn Header="Caller" Binding="{Binding Caller}" Width="130" />
                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="90" />
                <DataGridTemplateColumn Header="Secret" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:SecretValueText Text="{Binding Secret}" ToolTip="{Binding Secret}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Verdict" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:AuditVerdictText Text="{Binding Verdict}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Reason" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:AuditReasonText Text="{Binding Reason}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </local:RecordGrid>

        <!-- The selected entry in full. -->
        <local:DetailsPanel DataContext="{Binding SelectedItem, ElementName=Records}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource DetailsColumnGap}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:SpacedStackPanel Spacing="{StaticResource SectionHeadingSpacing}">
                    <local:SectionHeadingText Text="Caller chain" />
                    <local:FullValueText Text="{Binding ChainText}" />
                </local:SpacedStackPanel>
                <local:SpacedStackPanel Grid.Column="2" Spacing="{StaticResource PanelSectionSpacing}">
                    <local:SpacedStackPanel Spacing="{StaticResource SectionHeadingSpacing}">
                        <local:SectionHeadingText Text="Invocation" />
                        <local:FullValueText Text="{Binding ArgumentsText}" />
                    </local:SpacedStackPanel>
                    <local:SpacedStackPanel Spacing="{StaticResource SectionHeadingSpacing}">
                        <local:SectionHeadingText Text="Detail" />
                        <local:BodyText Text="{Binding Detail}" />
                    </local:SpacedStackPanel>
                </local:SpacedStackPanel>
            </Grid>
        </local:DetailsPanel>
    </local:SpacedStackPanel>
</local:StandardWindow>
