<local:StandardWindow x:Class="OpWarden.SessionAgent.RulesWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:OpWarden.SessionAgent"
                      Title="OpWarden rules"
                      AutomationProperties.AutomationId="RulesWindow"
                      Width="1040" Height="640" MinWidth="720" MinHeight="420"
                      WindowStartupLocation="CenterScreen">
    <local:SpacedStackPanel Margin="{StaticResource StandardWindowContentMargin}" Spacing="{StaticResource WindowSectionSpacing}">

        <!-- Whether this window may edit, and how to get there. -->
        <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource ToolbarGroupSpacing}">
            <local:HintText x:Name="ModeText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" />
            <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource CommandSpacing}">
                <local:AdministratorCommandButton x:Name="ElevateButton" Content="Edit as administrator" AutomationProperties.AutomationId="ElevateButton" Click="OnElevateClick" />
                <local:CommandButton Content="Refresh" Click="OnRefreshClick" />
            </local:SpacedStackPanel>
        </local:SpacedStackPanel>

        <local:RecordGrid x:Name="Records" local:SpacedStackPanel.Fill="True" AutomationProperties.AutomationId="RuleRecords" SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="70" />
                <DataGridTextColumn Header="Caller" Binding="{Binding Caller}" Width="140" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80" />
                <DataGridTemplateColumn Header="Vault" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:RuleFieldValueText Text="{Binding Vault}" ToolTip="{Binding Vault}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Item" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:RuleFieldValueText Text="{Binding Item}" ToolTip="{Binding Item}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Key" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:RuleFieldValueText Text="{Binding Key}" ToolTip="{Binding Key}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Cache" Binding="{Binding Cache}" Width="70" />
                <DataGridTextColumn Header="Notices" Binding="{Binding NoticeCount}" Width="70" />
            </DataGrid.Columns>
        </local:RecordGrid>

        <!-- The selected rule: its notices, and what can be done about it. -->
        <local:DetailsPanel>
            <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource ToolbarGroupSpacing}">
                <local:SpacedStackPanel local:SpacedStackPanel.Fill="True" Spacing="{StaticResource SectionHeadingSpacing}">
                    <local:SectionHeadingText Text="Notices" />
                    <local:HintText x:Name="NoNoticesText" Text="Select a rule to see what OpWarden noticed about it." />
                    <ItemsControl x:Name="NoticeList" Focusable="False" ItemsPanel="{StaticResource ListItemsLayout}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource ToolbarGroupSpacing}">
                                    <local:BodyText local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" Text="{Binding Text}" />
                                    <local:CommandButton Content="Add the matching rule" Visibility="{Binding SuggestionVisibility}" IsEnabled="{Binding CanApply}"
                                                         Tag="{Binding}" Click="OnAddSuggestionClick" />
                                </local:SpacedStackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </local:SpacedStackPanel>
                <local:CommandButton x:Name="RemoveButton" VerticalAlignment="Top" Content="Remove rule"
                                     AutomationProperties.AutomationId="RemoveRuleButton" Click="OnRemoveClick" />
            </local:SpacedStackPanel>
        </local:DetailsPanel>

        <!-- REQ-RULE-17: vaults where every invocation prompts. -->
        <local:SpacedStackPanel x:Name="PromptAlwaysPanel" Spacing="{StaticResource SectionHeadingSpacing}">
            <local:SectionHeadingText Text="Vaults that always prompt" />
            <ItemsControl x:Name="PromptAlwaysList" Focusable="False" ItemsPanel="{StaticResource ListItemsLayout}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource ToolbarGroupSpacing}">
                            <local:SecretValueText VerticalAlignment="Center" Text="{Binding}" />
                            <local:CommandButton Content="Stop always prompting" Tag="{Binding}" Click="OnClearPromptAlwaysClick"
                                                 IsEnabled="{Binding DataContext.Editable, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </local:SpacedStackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </local:SpacedStackPanel>

        <local:HintText x:Name="StatusText" />
    </local:SpacedStackPanel>
</local:StandardWindow>
