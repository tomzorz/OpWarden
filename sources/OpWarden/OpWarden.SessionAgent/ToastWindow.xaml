<Window x:Class="OpWarden.SessionAgent.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpWarden.SessionAgent"
        Title="OpWarden"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Grid x:Name="FrameHost" Margin="{StaticResource ToastShadowMargin}">
        <local:ToastFrame x:Name="Frame" Cursor="Hand">
            <local:SpacedStackPanel Spacing="{StaticResource ToastContentSpacing}">
                <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource HeaderItemSpacing}">
                    <local:ToastTitleText x:Name="TitleText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" />
                    <local:WindowCloseButton VerticalAlignment="Top" Click="OnCloseClick" />
                </local:SpacedStackPanel>
                <ItemsControl x:Name="LinesList" Focusable="False" ItemsPanel="{StaticResource ListItemsLayout}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:SecretValueText Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <local:BodyText x:Name="MessageText" />
                <local:HintText x:Name="FooterText" />
            </local:SpacedStackPanel>
        </local:ToastFrame>
    </Grid>
</Window>
