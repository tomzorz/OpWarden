<local:StandardWindow x:Class="OpWarden.SessionAgent.StatusWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:OpWarden.SessionAgent"
                      Title="OpWarden"
                      AutomationProperties.AutomationId="StatusWindow"
                      Width="520" SizeToContent="Height" ResizeMode="NoResize"
                      WindowStartupLocation="Manual">
    <local:SpacedStackPanel Margin="{StaticResource StandardWindowContentMargin}" Spacing="{StaticResource WindowSectionSpacing}">

        <!-- How the agent stands with the broker. -->
        <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource HeaderItemSpacing}">
            <local:BrokerLinkGlyph x:Name="LinkGlyph" VerticalAlignment="Center" />
            <local:SpacedStackPanel VerticalAlignment="Center" Spacing="{StaticResource HeaderSubtitleSpacing}">
                <local:WindowTitleText Text="OpWarden" />
                <local:HintText x:Name="LinkText" AutomationProperties.AutomationId="LinkState" />
            </local:SpacedStackPanel>
        </local:SpacedStackPanel>

        <!-- What the broker reports. The commands share one width, so they line up. -->
        <local:DetailsPanel>
            <local:SpacedStackPanel Grid.IsSharedSizeScope="True" Spacing="{StaticResource FieldRowSpacing}">
                <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource FieldColumnSpacing}">
                    <local:FieldLabelText Width="{StaticResource BrokerFactLabelWidth}" VerticalAlignment="Center" Text="Broker account" />
                    <local:BodyText x:Name="AccountText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" />
                </local:SpacedStackPanel>
                <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource FieldColumnSpacing}">
                    <local:FieldLabelText Width="{StaticResource BrokerFactLabelWidth}" VerticalAlignment="Center" Text="Process events" />
                    <local:BodyText x:Name="EventsText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" />
                </local:SpacedStackPanel>
                <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource FieldColumnSpacing}">
                    <local:FieldLabelText Width="{StaticResource BrokerFactLabelWidth}" VerticalAlignment="Center" Text="Cached values" />
                    <local:BodyText x:Name="CacheText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" AutomationProperties.AutomationId="CachedValues" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BrokerFactCommand" />
                        </Grid.ColumnDefinitions>
                        <local:CommandButton x:Name="FlushButton" Content="Flush cache" Click="OnFlushClick" />
                    </Grid>
                </local:SpacedStackPanel>
                <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource FieldColumnSpacing}">
                    <local:FieldLabelText Width="{StaticResource BrokerFactLabelWidth}" VerticalAlignment="Center" Text="Running since" />
                    <local:BodyText x:Name="StartedText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" />
                </local:SpacedStackPanel>
                <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource FieldColumnSpacing}">
                    <local:FieldLabelText Width="{StaticResource BrokerFactLabelWidth}" VerticalAlignment="Center" Text="Data folder" />
                    <local:SecretValueText x:Name="DataText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BrokerFactCommand" />
                        </Grid.ColumnDefinitions>
                        <local:CommandButton Content="Open" Click="OnOpenDataClick" />
                    </Grid>
                </local:SpacedStackPanel>
            </local:SpacedStackPanel>
        </local:DetailsPanel>

        <!-- The last few invocations. -->
        <local:SpacedStackPanel Spacing="{StaticResource SectionHeadingSpacing}">
            <local:SectionHeadingText Text="Recent invocations" />
            <ItemsControl x:Name="RecentList" Focusable="False" ItemsPanel="{StaticResource ListItemsLayout}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource ListColumnSpacing}">
                            <local:HintText Width="60" VerticalAlignment="Center" Text="{Binding Timestamp, StringFormat=HH:mm:ss, Converter={x:Static local:LocalTime.Converter}}" />
                            <local:CallerNameText Width="100" VerticalAlignment="Center" Text="{Binding Caller}" />
                            <local:SecretValueText local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" Text="{Binding Secret}" ToolTip="{Binding Secret}" />
                            <local:HintText VerticalAlignment="Center" Text="{Binding Outcome}" />
                        </local:SpacedStackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </local:SpacedStackPanel>

        <local:ErrorMessageText x:Name="ErrorText" Visibility="Collapsed" />

        <!-- What the list leaves out, beside the window that has it all. -->
        <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource ToolbarGroupSpacing}">
            <local:HintText x:Name="RecentSummaryText" local:SpacedStackPanel.Fill="True" VerticalAlignment="Center" AutomationProperties.AutomationId="RecentSummary" />
            <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource CommandSpacing}">
                <local:CommandButton Content="Audit log" Click="OnAuditClick" />
                <local:CommandButton Content="Rules" Click="OnRulesClick" />
            </local:SpacedStackPanel>
        </local:SpacedStackPanel>
    </local:SpacedStackPanel>
</local:StandardWindow>
