<!--
  The default look of every component in Components.cs, keyed by type, the gaps the layouts
  in Layouts.cs keep between components, and the tokens both share. Colours come from the
  palette (DynamicResource, so a theme switch repaints); sizes, shapes and gaps live here,
  each named for where it is used. Two tokens with the same value and different names are
  deliberate: they coincide today and are free to part tomorrow.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:OpWarden.SessionAgent">

    <!-- Typography -->
    <FontFamily x:Key="InterfaceFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SecretValueFontFamily">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="HintFontSize">11.5</sys:Double>
    <sys:Double x:Key="PromptCountdownFontSize">11.5</sys:Double>
    <sys:Double x:Key="PromptTitleFontSize">17</sys:Double>
    <sys:Double x:Key="WindowTitleFontSize">15</sys:Double>
    <sys:Double x:Key="SectionHeadingFontSize">12</sys:Double>
    <sys:Double x:Key="RecordGridHeaderFontSize">12</sys:Double>
    <sys:Double x:Key="ToastTitleFontSize">13.5</sys:Double>
    <sys:Double x:Key="SecretValueFontSize">12.5</sys:Double>
    <FontWeight x:Key="WindowTitleFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="PromptTitleFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="SectionHeadingFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="RecordGridHeaderFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="ToastTitleFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="DecisionButtonFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="DeniedVerdictFontWeight">SemiBold</FontWeight>
    <FontStyle x:Key="RuleWildcardFontStyle">Italic</FontStyle>

    <!-- Gaps the layouts keep, each named for what it separates -->
    <sys:Double x:Key="WindowSectionSpacing">16</sys:Double>
    <sys:Double x:Key="PanelSectionSpacing">12</sys:Double>
    <sys:Double x:Key="SectionHeadingSpacing">6</sys:Double>
    <sys:Double x:Key="SupportingTextSpacing">8</sys:Double>
    <sys:Double x:Key="HeaderItemSpacing">12</sys:Double>
    <sys:Double x:Key="HeaderSubtitleSpacing">4</sys:Double>
    <sys:Double x:Key="CommandSpacing">8</sys:Double>
    <sys:Double x:Key="ToolbarGroupSpacing">16</sys:Double>
    <sys:Double x:Key="FieldRowSpacing">6</sys:Double>
    <sys:Double x:Key="FieldColumnSpacing">10</sys:Double>
    <sys:Double x:Key="ListItemSpacing">4</sys:Double>
    <sys:Double x:Key="ListColumnSpacing">10</sys:Double>
    <sys:Double x:Key="CacheChoiceSpacing">6</sys:Double>
    <sys:Double x:Key="ToastContentSpacing">6</sys:Double>
    <GridLength x:Key="DetailsColumnGap">16</GridLength>
    <!-- Between a standard window's edges and its content. -->
    <Thickness x:Key="StandardWindowContentMargin">16</Thickness>
    <!-- Around the prompt's frame: room for its shadow. -->
    <Thickness x:Key="PromptShadowMargin">16</Thickness>
    <!-- Around a toast's frame: room for its shadow, and half the gap between stacked toasts. -->
    <Thickness x:Key="ToastShadowMargin">12,6</Thickness>
    <!-- The label column of the prompt's request fields and of the broker's facts. -->
    <sys:Double x:Key="PromptFieldLabelWidth">86</sys:Double>
    <sys:Double x:Key="BrokerFactLabelWidth">120</sys:Double>

    <!-- Shapes -->
    <CornerRadius x:Key="WindowFrameCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ToastFrameCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ToastFrameOnWindowCornerRadius">8,8,0,0</CornerRadius>
    <!-- The toast frame's corner radius less its 1 px outline: where the inside is clipped. -->
    <sys:Double x:Key="ToastFrameInsideRadius">7</sys:Double>
    <CornerRadius x:Key="DetailsPanelCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DecisionButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CommandButtonCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="WindowCloseButtonCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="CacheChoiceSegmentCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="RecordFilterBoxCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="CheckBoxCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ScrollThumbCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="MenuCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="MenuItemCornerRadius">4</CornerRadius>

    <!-- Inner spacing: each component's own padding -->
    <Thickness x:Key="WindowFrameContentPadding">20,16,20,18</Thickness>
    <Thickness x:Key="ToastFrameContentPadding">14,11,12,12</Thickness>
    <Thickness x:Key="DetailsPanelPadding">14,10</Thickness>
    <Thickness x:Key="DecisionButtonPadding">14,8</Thickness>
    <Thickness x:Key="CommandButtonPadding">12,5</Thickness>
    <Thickness x:Key="CacheChoiceSegmentPadding">10,5</Thickness>
    <Thickness x:Key="RecordFilterBoxPadding">8,5</Thickness>
    <Thickness x:Key="RecordGridHeaderPadding">8,5</Thickness>
    <Thickness x:Key="RecordGridCellPadding">8,5</Thickness>
    <Thickness x:Key="MenuPadding">4</Thickness>
    <Thickness x:Key="MenuItemPadding">12,6,24,6</Thickness>
    <Thickness x:Key="MenuSeparatorInset">8,4</Thickness>
    <Thickness x:Key="ScrollThumbInset">2</Thickness>
    <!-- WPF insets a text box's own text by 2 px whatever its template says; the placeholder matches it. -->
    <Thickness x:Key="RecordFilterBoxPlaceholderInset">2,0,0,0</Thickness>
    <sys:Double x:Key="CheckBoxLabelSpacing">8</sys:Double>
    <sys:Double x:Key="AdministratorGlyphSpacing">7</sys:Double>

    <!-- Lines and shadows -->
    <Thickness x:Key="WindowFrameBorderThickness">1</Thickness>
    <Thickness x:Key="ToastFrameBorderThickness">1</Thickness>
    <Thickness x:Key="DecisionButtonFocusOutlineThickness">2</Thickness>
    <Thickness x:Key="CommandButtonBorderThickness">1</Thickness>
    <Thickness x:Key="CacheChoiceSegmentBorderThickness">1</Thickness>
    <Thickness x:Key="RecordFilterBoxBorderThickness">1</Thickness>
    <Thickness x:Key="CheckBoxBorderThickness">1</Thickness>
    <Thickness x:Key="MenuBorderThickness">1</Thickness>
    <Thickness x:Key="RecordGridHeaderSeparatorThickness">0,0,0,1</Thickness>
    <sys:Double x:Key="MenuSeparatorThickness">1</sys:Double>
    <sys:Double x:Key="ToastLifetimeBarThickness">3</sys:Double>
    <sys:Double x:Key="ScrollBarThickness">10</sys:Double>
    <sys:Double x:Key="WindowShadowBlurRadius">18</sys:Double>
    <sys:Double x:Key="WindowShadowDepth">2</sys:Double>
    <sys:Double x:Key="WindowShadowOpacity">0.4</sys:Double>
    <sys:Double x:Key="DisabledControlOpacity">0.45</sys:Double>

    <!-- Glyphs -->
    <Geometry x:Key="OpWardenShieldGeometry">M 8,0 L 16,3 L 16,8 C 16,13 12,16.5 8,18 C 4,16.5 0,13 0,8 L 0,3 Z</Geometry>
    <Geometry x:Key="AdministratorShieldGeometry">M 8,0 L 16,3 L 16,8 C 16,13 12,16.5 8,18 C 4,16.5 0,13 0,8 L 0,3 Z</Geometry>
    <Geometry x:Key="WindowCloseGlyphGeometry">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>
    <Geometry x:Key="CheckBoxGlyphGeometry">M 0,4 L 3.5,7.5 L 10,0</Geometry>
    <sys:Double x:Key="OpWardenMarkWidth">18</sys:Double>
    <sys:Double x:Key="OpWardenMarkHeight">20</sys:Double>
    <sys:Double x:Key="BrokerLinkGlyphWidth">20</sys:Double>
    <sys:Double x:Key="BrokerLinkGlyphHeight">22</sys:Double>
    <sys:Double x:Key="AdministratorGlyphWidth">12</sys:Double>
    <sys:Double x:Key="AdministratorGlyphHeight">13</sys:Double>
    <sys:Double x:Key="WindowCloseButtonSize">26</sys:Double>
    <sys:Double x:Key="WindowCloseGlyphSize">10</sys:Double>
    <sys:Double x:Key="WindowCloseGlyphThickness">1.4</sys:Double>
    <sys:Double x:Key="CheckBoxSize">16</sys:Double>
    <sys:Double x:Key="CheckBoxGlyphWidth">10</sys:Double>
    <sys:Double x:Key="CheckBoxGlyphHeight">8</sys:Double>
    <sys:Double x:Key="CheckBoxGlyphThickness">1.8</sys:Double>

    <!-- List layouts: the gap between the items of an ItemsControl -->
    <ItemsPanelTemplate x:Key="ListItemsLayout">
        <local:SpacedStackPanel Spacing="{StaticResource ListItemSpacing}" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="FieldRowsLayout">
        <local:SpacedStackPanel Spacing="{StaticResource FieldRowSpacing}" />
    </ItemsPanelTemplate>

    <!-- Every window with standard chrome -->
    <Style TargetType="local:StandardWindow">
        <Setter Property="Background" Value="{DynamicResource WindowBackdropBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Every borderless window -->
    <Style TargetType="local:WindowFrame">
        <Setter Property="Padding" Value="{StaticResource WindowFrameContentPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:WindowFrame">
                    <Grid>
                        <!-- The shadow sits on a sibling of the content, so text keeps ClearType. -->
                        <Border Background="{DynamicResource WindowBackdropBrush}" CornerRadius="{StaticResource WindowFrameCornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{StaticResource WindowShadowBlurRadius}" ShadowDepth="{StaticResource WindowShadowDepth}" Opacity="{StaticResource WindowShadowOpacity}" Color="{DynamicResource WindowShadowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border BorderBrush="{DynamicResource WindowFrameBorderBrush}" BorderThickness="{StaticResource WindowFrameBorderThickness}" CornerRadius="{StaticResource WindowFrameCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toasts -->
    <Style TargetType="local:ToastFrame">
        <Setter Property="Padding" Value="{StaticResource ToastFrameContentPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToastFrame">
                    <Grid>
                        <Border x:Name="Backdrop" Background="{DynamicResource ToastBackgroundBrush}" CornerRadius="{StaticResource ToastFrameCornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{StaticResource WindowShadowBlurRadius}" ShadowDepth="{StaticResource WindowShadowDepth}" Opacity="{StaticResource WindowShadowOpacity}" Color="{DynamicResource WindowShadowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Outline" BorderBrush="{DynamicResource ToastFrameBorderBrush}" BorderThickness="{StaticResource ToastFrameBorderThickness}" CornerRadius="{StaticResource ToastFrameCornerRadius}">
                            <!-- ToastFrame clips this to the outline's corners. -->
                            <Grid x:Name="PART_Inside">
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                                <local:ToastLifetimeBar x:Name="LifetimeBar" VerticalAlignment="Top" Foreground="{DynamicResource NoticeAccentBrush}" Value="{TemplateBinding RemainingLifetime}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="CachedRead">
                            <Setter TargetName="LifetimeBar" Property="Foreground" Value="{DynamicResource CachedReadAccentBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="RuleRead">
                            <Setter TargetName="LifetimeBar" Property="Foreground" Value="{DynamicResource RuleReadAccentBrush}" />
                        </Trigger>
                        <Trigger Property="SitsOnWindow" Value="True">
                            <Setter TargetName="Backdrop" Property="CornerRadius" Value="{StaticResource ToastFrameOnWindowCornerRadius}" />
                            <Setter TargetName="Outline" Property="CornerRadius" Value="{StaticResource ToastFrameOnWindowCornerRadius}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ToastLifetimeBar">
        <Setter Property="Height" Value="{StaticResource ToastLifetimeBarThickness}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ToastLifetimeTrackBrush}" />
        <Setter Property="AutomationProperties.AutomationId" Value="ToastLifetime" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- ProgressBar sizes PART_Indicator to the value's share of PART_Track. -->
                <ControlTemplate TargetType="local:ToastLifetimeBar">
                    <Grid x:Name="PART_Track" Background="{TemplateBinding Background}">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panels and marks -->
    <Style TargetType="local:DetailsPanel">
        <Setter Property="Padding" Value="{StaticResource DetailsPanelPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource DetailsPanelCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource DetailsPanelBackgroundBrush}" />
    </Style>

    <Style TargetType="local:OpWardenMark">
        <Setter Property="Foreground" Value="{DynamicResource OpWardenMarkBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OpWardenMark">
                    <Path Width="{StaticResource OpWardenMarkWidth}" Height="{StaticResource OpWardenMarkHeight}" Stretch="Uniform"
                          Fill="{TemplateBinding Foreground}" Data="{StaticResource OpWardenShieldGeometry}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The colour comes from BrokerLinkGlyph.State, which the tray icon shares. -->
    <Style TargetType="local:BrokerLinkGlyph">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:BrokerLinkGlyph">
                    <Path Width="{StaticResource BrokerLinkGlyphWidth}" Height="{StaticResource BrokerLinkGlyphHeight}" Stretch="Uniform"
                          Fill="{TemplateBinding Foreground}" Data="{StaticResource OpWardenShieldGeometry}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Decision buttons -->
    <ControlTemplate x:Key="DecisionButtonTemplate" TargetType="local:DecisionButton">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="{StaticResource DecisionButtonFocusOutlineThickness}"
                CornerRadius="{StaticResource DecisionButtonCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DecisionButtonBase" TargetType="local:DecisionButton">
        <Setter Property="Padding" Value="{StaticResource DecisionButtonPadding}" />
        <Setter Property="FontWeight" Value="{StaticResource DecisionButtonFontWeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DecisionButtonTemplate}" />
    </Style>

    <Style TargetType="local:AllowDecisionButton" BasedOn="{StaticResource DecisionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource AllowDecisionBackgroundBrush}" />
        <Setter Property="HoverBackground" Value="{DynamicResource AllowDecisionHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AllowDecisionForegroundBrush}" />
    </Style>

    <Style TargetType="local:DenyDecisionButton" BasedOn="{StaticResource DecisionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource DenyDecisionBackgroundBrush}" />
        <Setter Property="HoverBackground" Value="{DynamicResource DenyDecisionHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DenyDecisionForegroundBrush}" />
    </Style>

    <!-- Secondary commands -->
    <Style TargetType="local:CommandButton">
        <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
        <Setter Property="Padding" Value="{StaticResource CommandButtonPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource CommandButtonBorderThickness}"
                            CornerRadius="{StaticResource CommandButtonCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CommandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:AdministratorCommandButton" BasedOn="{StaticResource {x:Type local:CommandButton}}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource AdministratorGlyphSpacing}">
                        <Path Width="{StaticResource AdministratorGlyphWidth}" Height="{StaticResource AdministratorGlyphHeight}" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource AdministratorGlyphBrush}" Data="{StaticResource AdministratorShieldGeometry}" />
                        <ContentPresenter Content="{Binding}" VerticalAlignment="Center" />
                    </local:SpacedStackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:WindowCloseButton">
        <Setter Property="Foreground" Value="{DynamicResource WindowCloseGlyphBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="Close" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Width="{StaticResource WindowCloseButtonSize}" Height="{StaticResource WindowCloseButtonSize}" Background="Transparent"
                            CornerRadius="{StaticResource WindowCloseButtonCornerRadius}">
                        <Path Width="{StaticResource WindowCloseGlyphSize}" Height="{StaticResource WindowCloseGlyphSize}" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="{StaticResource WindowCloseGlyphThickness}" Data="{StaticResource WindowCloseGlyphGeometry}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <!-- Pins and filter toggles share one check box look; each keeps its own default style. -->
    <Style x:Key="CheckBoxBase" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <local:SpacedStackPanel Orientation="Horizontal" Spacing="{StaticResource CheckBoxLabelSpacing}" Background="Transparent">
                        <Border x:Name="Box" Width="{StaticResource CheckBoxSize}" Height="{StaticResource CheckBoxSize}" CornerRadius="{StaticResource CheckBoxCornerRadius}"
                                BorderThickness="{StaticResource CheckBoxBorderThickness}" BorderBrush="{DynamicResource InputBorderBrush}" Background="{DynamicResource InputBackgroundBrush}"
                                VerticalAlignment="Center">
                            <Path x:Name="Glyph" Width="{StaticResource CheckBoxGlyphWidth}" Height="{StaticResource CheckBoxGlyphHeight}" Stretch="Uniform"
                                  Stroke="{DynamicResource CheckedBoxGlyphBrush}" StrokeThickness="{StaticResource CheckBoxGlyphThickness}"
                                  Data="{StaticResource CheckBoxGlyphGeometry}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </local:SpacedStackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CheckedBoxBackgroundBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource CheckedBoxBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:FieldPinCheckBox" BasedOn="{StaticResource CheckBoxBase}" />

    <Style TargetType="local:RecordFilterToggle" BasedOn="{StaticResource CheckBoxBase}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="local:CacheChoiceSegment">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Padding" Value="{StaticResource CacheChoiceSegmentPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource CacheChoiceSegmentBorderThickness}"
                            CornerRadius="{StaticResource CacheChoiceSegmentCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedChoiceBackgroundBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectedChoiceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedChoiceForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RecordFilterBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="{StaticResource RecordFilterBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RecordFilterBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{StaticResource RecordFilterBoxBorderThickness}"
                            CornerRadius="{StaticResource RecordFilterBoxCornerRadius}">
                        <!--
                          WPF applies a text box's Padding to its text itself, plus its own inset;
                          the placeholder takes the same Padding, inset, font and size, so the two
                          line up exactly.
                        -->
                        <Grid>
                            <TextBlock x:Name="PlaceholderText" Margin="{StaticResource RecordFilterBoxPlaceholderInset}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Records -->
    <Style TargetType="local:RecordGrid">
        <Setter Property="Background" Value="{DynamicResource GridRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource GridRowBackgroundBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternateRowBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                    <Setter Property="FontSize" Value="{StaticResource RecordGridHeaderFontSize}" />
                    <Setter Property="FontWeight" Value="{StaticResource RecordGridHeaderFontWeight}" />
                    <Setter Property="Padding" Value="{StaticResource RecordGridHeaderPadding}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GridSeparatorBrush}" />
                    <Setter Property="BorderThickness" Value="{StaticResource RecordGridHeaderSeparatorThickness}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="{StaticResource RecordGridCellPadding}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GridSelectedRowBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text roles -->
    <Style TargetType="local:WindowTitleText">
        <Setter Property="FontSize" Value="{StaticResource WindowTitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource WindowTitleFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="local:PromptTitleText">
        <Setter Property="FontSize" Value="{StaticResource PromptTitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource PromptTitleFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:PromptCountdownText">
        <Setter Property="FontSize" Value="{StaticResource PromptCountdownFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsUrgent" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CountdownUrgentTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="local:SectionHeadingText">
        <Setter Property="FontSize" Value="{StaticResource SectionHeadingFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource SectionHeadingFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style TargetType="local:FieldLabelText">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <!-- What every value set apart from prose shares; each value component keeps its own style. -->
    <Style x:Key="SecretValueTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SecretValueFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SecretValueFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SecretValueTextBrush}" />
    </Style>

    <Style TargetType="local:SecretValueText" BasedOn="{StaticResource SecretValueTextBase}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style TargetType="local:FullValueText" BasedOn="{StaticResource SecretValueTextBase}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:RuleFieldValueText" BasedOn="{StaticResource SecretValueTextBase}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <Trigger Property="Text" Value="any">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
                <Setter Property="FontStyle" Value="{StaticResource RuleWildcardFontStyle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="local:AuditVerdictText">
        <Style.Triggers>
            <Trigger Property="Text" Value="Deny">
                <Setter Property="Foreground" Value="{DynamicResource DeniedVerdictTextBrush}" />
                <Setter Property="FontWeight" Value="{StaticResource DeniedVerdictFontWeight}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="local:AuditReasonText">
        <Style.Triggers>
            <Trigger Property="Text" Value="cache">
                <Setter Property="Foreground" Value="{DynamicResource CachedReasonTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="local:CallerNameText">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style TargetType="local:BodyText">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:HintText">
        <Setter Property="FontSize" Value="{StaticResource HintFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:ErrorMessageText">
        <Setter Property="FontSize" Value="{StaticResource HintFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:ToastTitleText">
        <Setter Property="FontSize" Value="{StaticResource ToastTitleFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource ToastTitleFontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Framework controls every window shares: scrollbars and the tray menu. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Thumb" CornerRadius="{StaticResource ScrollThumbCornerRadius}" Background="{DynamicResource ScrollThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="MinWidth" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Margin="{StaticResource ScrollThumbInset}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{StaticResource ScrollBarThickness}" />
                <Setter Property="MinHeight" Value="{StaticResource ScrollBarThickness}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Margin="{StaticResource ScrollThumbInset}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="{StaticResource MenuBorderThickness}"
                            CornerRadius="{StaticResource MenuCornerRadius}" Padding="{StaticResource MenuPadding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource MenuItemCornerRadius}" Padding="{StaticResource MenuItemPadding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuHighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus look their separators up by this key rather than by type. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="{StaticResource MenuSeparatorThickness}" Margin="{StaticResource MenuSeparatorInset}" Background="{DynamicResource MenuSeparatorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
