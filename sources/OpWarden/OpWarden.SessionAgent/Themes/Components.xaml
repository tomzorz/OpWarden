<!--
  The default look of every component in Components.cs, keyed by type, plus the tokens they
  share. Colours come from the palette (DynamicResource, so a theme switch repaints);
  sizes and shapes live here, each named for where it is used.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:OpWarden.SessionAgent">

    <!-- Typography -->
    <FontFamily x:Key="InterfaceFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SecretValueFontFamily">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="HintFontSize">11.5</sys:Double>
    <sys:Double x:Key="PromptTitleFontSize">17</sys:Double>
    <sys:Double x:Key="WindowTitleFontSize">15</sys:Double>
    <sys:Double x:Key="SectionHeadingFontSize">12</sys:Double>
    <sys:Double x:Key="ToastTitleFontSize">13.5</sys:Double>
    <sys:Double x:Key="SecretValueFontSize">12.5</sys:Double>

    <!-- Shapes and inner spacing -->
    <CornerRadius x:Key="WindowFrameCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ToastFrameCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DecisionButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CommandButtonCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="CacheChoiceSegmentCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="RecordFilterBoxCornerRadius">5</CornerRadius>
    <Thickness x:Key="WindowFrameContentPadding">20,16,20,18</Thickness>
    <Thickness x:Key="ToastFrameContentPadding">14,11,12,12</Thickness>
    <Thickness x:Key="DecisionButtonPadding">14,8</Thickness>
    <Thickness x:Key="CommandButtonPadding">12,5</Thickness>
    <Thickness x:Key="CacheChoiceSegmentPadding">10,5</Thickness>
    <Thickness x:Key="RecordFilterBoxPadding">8,5</Thickness>
    <Thickness x:Key="RecordGridCellPadding">8,5</Thickness>
    <sys:Double x:Key="WindowShadowBlurRadius">18</sys:Double>
    <GridLength x:Key="ToastAccentStripWidth">4</GridLength>

    <!-- Every borderless window -->
    <Style TargetType="local:WindowFrame">
        <Setter Property="Padding" Value="{StaticResource WindowFrameContentPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:WindowFrame">
                    <Grid>
                        <!-- The shadow sits on a sibling of the content, so text keeps ClearType. -->
                        <Border Background="{DynamicResource WindowBackdropBrush}" CornerRadius="{StaticResource WindowFrameCornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{StaticResource WindowShadowBlurRadius}" ShadowDepth="2" Opacity="0.4" Color="{DynamicResource WindowShadowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border BorderBrush="{DynamicResource WindowFrameBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource WindowFrameCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toasts -->
    <Style TargetType="local:ToastFrame">
        <Setter Property="Padding" Value="{StaticResource ToastFrameContentPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToastFrame">
                    <Grid>
                        <Border Background="{DynamicResource ToastBackgroundBrush}" CornerRadius="{StaticResource ToastFrameCornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="{StaticResource WindowShadowBlurRadius}" ShadowDepth="2" Opacity="0.4" Color="{DynamicResource WindowShadowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border BorderBrush="{DynamicResource WindowFrameBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ToastFrameCornerRadius}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ToastAccentStripWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{TemplateBinding Accent}" CornerRadius="7,0,0,7" />
                                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Decision buttons -->
    <ControlTemplate x:Key="DecisionButtonTemplate" TargetType="local:DecisionButton">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2"
                CornerRadius="{StaticResource DecisionButtonCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DecisionButtonBase" TargetType="local:DecisionButton">
        <Setter Property="Padding" Value="{StaticResource DecisionButtonPadding}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource DecisionButtonTemplate}" />
    </Style>

    <Style TargetType="local:AllowDecisionButton" BasedOn="{StaticResource DecisionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource AllowDecisionBackgroundBrush}" />
        <Setter Property="HoverBackground" Value="{DynamicResource AllowDecisionHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AllowDecisionForegroundBrush}" />
    </Style>

    <Style TargetType="local:DenyDecisionButton" BasedOn="{StaticResource DecisionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource DenyDecisionBackgroundBrush}" />
        <Setter Property="HoverBackground" Value="{DynamicResource DenyDecisionHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DenyDecisionForegroundBrush}" />
    </Style>

    <!-- Secondary commands -->
    <Style TargetType="local:CommandButton">
        <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CommandBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource CommandForegroundBrush}" />
        <Setter Property="Padding" Value="{StaticResource CommandButtonPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CommandButtonCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CommandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:AdministratorCommandButton" BasedOn="{StaticResource {x:Type local:CommandButton}}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="13" Stretch="Uniform" VerticalAlignment="Center" Fill="{DynamicResource AdministratorGlyphBrush}"
                              Data="M 8,0 L 16,3 L 16,8 C 16,13 12,16.5 8,18 C 4,16.5 0,13 0,8 L 0,3 Z" />
                        <ContentPresenter Margin="7,0,0,0" Content="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:WindowCloseButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="Close" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Width="26" Height="26" Background="Transparent" CornerRadius="5">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CommandHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <!-- Pins and filter toggles share one check box look; each keeps its own default style. -->
    <Style x:Key="CheckBoxBase" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorderBrush}" Background="{DynamicResource InputBackgroundBrush}" VerticalAlignment="Center">
                            <Path x:Name="Glyph" Width="10" Height="8" Stretch="Uniform" Stroke="{DynamicResource PinCheckGlyphBrush}" StrokeThickness="1.8"
                                  Data="M 0,4 L 3.5,7.5 L 10,0" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PinCheckedBackgroundBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PinCheckedBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:FieldPinCheckBox" BasedOn="{StaticResource CheckBoxBase}" />

    <Style TargetType="local:RecordFilterToggle" BasedOn="{StaticResource CheckBoxBase}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="local:CacheChoiceSegment">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Padding" Value="{StaticResource CacheChoiceSegmentPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource CacheChoiceSegmentCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedChoiceBackgroundBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SelectedChoiceBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedChoiceForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:RecordFilterBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="{StaticResource RecordFilterBoxPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:RecordFilterBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RecordFilterBoxCornerRadius}">
                        <!--
                          WPF applies a text box's Padding to its text itself, plus a 2 px inset
                          of its own; the placeholder takes the same Padding, inset, font and
                          size, so the two line up exactly.
                        -->
                        <Grid>
                            <TextBlock x:Name="PlaceholderText" Margin="2,0,0,0" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                                       Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Records -->
    <Style TargetType="local:RecordGrid">
        <Setter Property="Background" Value="{DynamicResource GridRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource GridRowBackgroundBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternateRowBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                    <Setter Property="FontSize" Value="{StaticResource SectionHeadingFontSize}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="{StaticResource RecordGridCellPadding}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GridSeparatorBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="{StaticResource RecordGridCellPadding}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GridSelectedRowBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text roles -->
    <Style TargetType="local:WindowTitleText">
        <Setter Property="FontSize" Value="{StaticResource WindowTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="local:PromptTitleText">
        <Setter Property="FontSize" Value="{StaticResource PromptTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:SectionHeadingText">
        <Setter Property="FontSize" Value="{StaticResource SectionHeadingFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style TargetType="local:FieldLabelText">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="local:SecretValueText">
        <Setter Property="FontFamily" Value="{StaticResource SecretValueFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SecretValueFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SecretValueTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="local:BodyText">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:HintText">
        <Setter Property="FontSize" Value="{StaticResource HintFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="local:ToastTitleText">
        <Setter Property="FontSize" Value="{StaticResource ToastTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Framework controls every window shares: scrollbars and the tray menu. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Thumb" CornerRadius="4" Background="{DynamicResource ScrollThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Margin="2" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Margin="2" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource WindowFrameBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="12,6,24,6">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuHighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus look their separators up by this key rather than by type. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="{DynamicResource GridSeparatorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
