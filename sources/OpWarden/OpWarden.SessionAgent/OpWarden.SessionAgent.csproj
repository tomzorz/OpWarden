<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Main lives in Program.cs: the agent picks its mode from the arguments first. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!--
      Spec section 3: WPF rules out NativeAOT, so the session agent ships self-contained
      (install/publish.ps1). It then loads no shared runtime that DOTNET_ROOT could
      redirect, and with startup hooks off no environment variable can load code into it.
    -->
    <StartupHookSupport>false</StartupHookSupport>

    <!-- WPF's font cache builds real cultures; invariant mode throws on every text layout. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Per-monitor DPI awareness. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpWarden.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpWarden.Core\OpWarden.Core.csproj" />
  </ItemGroup>

</Project>
